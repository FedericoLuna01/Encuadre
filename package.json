{
  "name": "full-page-capture",
  "version": "0.1.0",
  "description": "Capturá páginas completas o su parte visible, probá tamaños de celular y exportá en PNG, JPEG o PDF. Sin cuenta.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "icons": "node scripts/generate-icons.mjs",
    "build": "tsc -b && vite build && node scripts/build-extension.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:all": "npm run build && npm test && npm run test:e2e",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:quality": "node tests/capture-quality.mjs",
    "test:popup": "node tests/popup-native.mjs",
    "test:action": "node tests/action.mjs",
    "test:permissions": "node scripts/test-e2e.mjs permissions",
    "test:devices": "node tests/inline.mjs",
    "test:inline": "node tests/inline.mjs",
    "test:p1": "node tests/p1.mjs",
    "test:editor": "node scripts/test-e2e.mjs editor",
    "test:pdf": "node scripts/test-e2e.mjs pdf",
    "optimize:frames": "node scripts/optimize-frames.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
